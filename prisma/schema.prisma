// Prisma Schema for Smart Apartment Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  MANAGER
  STAFF_TECHNICIAN
  STAFF_SECURITY
  STAFF_RECEPTIONIST
  RESIDENT
}

enum ApartmentStatus {
  VACANT
  OCCUPIED
  UNDER_MAINTENANCE
}

enum ApartmentHistoryEvent {
  OWNER_TRANSFER
  TENANT_MOVE_IN
  TENANT_MOVE_OUT
  RESIDENT_MOVE_IN
  RESIDENT_MOVE_OUT
  STATUS_CHANGE
}

enum ResidentStatus {
  RESIDING
  MOVED_OUT
  TEMPORARY_ABSENT
}

enum ResidentRelationship {
  OWNER
  FAMILY
  TENANT
  TEMPORARY_RESIDENT
}

enum ResidenceRequestType {
  TEMPORARY_RESIDENCE
  TEMPORARY_ABSENCE
  ADD_MEMBER
  MOVE_IN
  MOVE_OUT
}

enum ResidenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractType {
  SALE
  RENT
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum FeeUnit {
  PER_M2
  PER_MONTH
  PER_VEHICLE
  PER_KWH
  PER_M3
  FIXED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  VNPAY
  MOMO
  BANK_TRANSFER
  CASH
}

enum TicketCategory {
  ELECTRIC
  WATER
  ELEVATOR
  SECURITY
  CLEANLINESS
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum TicketStatus {
  NEW
  ASSIGNED
  PROCESSING
  RESOLVED
  CLOSED
  REJECTED
}

enum VehicleType {
  CAR
  MOTORBIKE
  BICYCLE
  ELECTRIC_BIKE
}

enum VehicleStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}

enum ParkingCardStatus {
  ACTIVE
  LOCKED
  EXPIRED
  PENDING
}

enum SlotVehicleType {
  CAR
  MOTORBIKE
  BICYCLE
  EV
  DISABLED
  VISITOR
}

enum ParkingSlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
  INACTIVE
}

enum ParkingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ParkingAssignmentStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

enum ParkingLogDirection {
  ENTRY
  EXIT
}

enum ParkingLogStatus {
  SUCCESS
  REJECTED
  ALERT
}

enum StaffShift {
  MORNING   // 06:00 - 14:00
  AFTERNOON // 14:00 - 22:00
  NIGHT     // 22:00 - 06:00
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum AssetCategory {
  ELEVATOR
  WATER_PUMP
  FIRE_ALARM
  FIRE_EXTINGUISHER
  GENERATOR
  CCTV
  BARRIER
  AIR_CONDITIONER
  ELECTRICAL_SYSTEM
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  BROKEN
  RETIRED
}

enum MaintenanceCycle {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum FacilityType {
  GYM
  SWIMMING_POOL
  BBQ_AREA
  COMMUNITY_ROOM
  SPORTS_COURT
  MEETING_ROOM
  OTHER
}

enum FacilityStatus {
  ACTIVE
  MAINTENANCE
  BLOCKED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VisitorStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  CANCELLED
}

// 1. User & Account Auth
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String?
  avatarUrl     String?
  role          Role           @default(RESIDENT)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  residentProfile       Resident?
  staffProfile          StaffProfile?
  sentNotifications     Notification[]        @relation("SentNotifications")
  readNotifications     NotificationRead[]
  assignedTickets       Feedback[]            @relation("AssignedStaff")
  ticketStatusChanges   TicketStatusHistory[]
  ticketComments        TicketComment[]
  requestedResidence    ResidenceRequest[]    @relation("RequestedResidence")
  reviewedResidence     ResidenceRequest[]    @relation("ReviewedResidence")
  technicianSchedules   MaintenanceSchedule[] @relation("TechnicianSchedules")
  technicianWorkOrders  WorkOrder[]           @relation("TechnicianWorkOrders")
  facilityBookings      FacilityBooking[]
  createdVisitorPasses    VisitorPass[]       @relation("CreatedVisitorPasses")
  checkedInVisitorPasses  VisitorPass[]       @relation("CheckedInVisitorPasses")
  checkedOutVisitorPasses VisitorPass[]       @relation("CheckedOutVisitorPasses")
  receivedParcels         ParcelDelivery[]    @relation("ReceivedParcels")
  handedOverParcels       ParcelDelivery[]    @relation("HandedOverParcels")
  createdPolls            Poll[]              @relation("CreatedPolls")
  managedBuildings        ManagerBuilding[]   @relation("ManagedBuildings")
  reviewedParkingRequests    ParkingRegistrationRequest[] @relation("ReviewedParkingRequests")
  assignedParkingAssignments ParkingAssignment[]          @relation("AssignedParkingAssignments")
  operatedParkingAccessLogs  ParkingAccessLog[]           @relation("OperatedParkingAccessLogs")

  @@map("users")
}

// 2. Property Hierarchy
model Building {
  id          String      @id @default(cuid())
  code        String      @unique // e.g. "SMART-CITY"
  name        String      // e.g. "SmartCity Complex"
  address     String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  blocks      Block[]
  apartments  Apartment[]
  assets      Asset[]
  facilities  Facility[]
  managers    ManagerBuilding[] @relation("BuildingManagers")
  parkingAreas ParkingArea[]

  @@map("buildings")
}

// 2.0 Manager-to-Building Assignment (Scope Enforcement)
model ManagerBuilding {
  id         String   @id @default(cuid())
  managerId  String
  manager    User     @relation("ManagedBuildings", fields: [managerId], references: [id], onDelete: Cascade)
  buildingId String
  building   Building @relation("BuildingManagers", fields: [buildingId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([managerId, buildingId])
  @@index([managerId])
  @@index([buildingId])
  @@map("manager_buildings")
}

model Block {
  id          String      @id @default(cuid())
  buildingId  String
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code        String      // e.g. "BLOCK-A", "BLOCK-B"
  name        String      // e.g. "Tháp Sky (Block A)"
  totalFloors Int         @default(25)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  floors      Floor[]
  apartments  Apartment[]

  @@unique([buildingId, code])
  @@index([buildingId])
  @@map("blocks")
}

model Floor {
  id          String      @id @default(cuid())
  blockId     String
  block       Block       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  floorNumber Int         // e.g. 10
  name        String      // e.g. "Tầng 10"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  apartments  Apartment[]

  @@unique([blockId, floorNumber])
  @@index([blockId])
  @@map("floors")
}

// 2.1 Apartment
model Apartment {
  id        String          @id @default(cuid())
  code      String          @unique // e.g. "A-1001"
  building  String // e.g. "Tòa A" (backward-compatible)
  floor     Int // e.g. 10 (backward-compatible)
  bedrooms  Int             @default(2)
  bathrooms Int             @default(2)
  area      Float // m2
  status    ApartmentStatus @default(VACANT)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Optional hierarchy relations
  buildingId  String?
  buildingRef Building?     @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  blockId     String?
  block       Block?        @relation(fields: [blockId], references: [id], onDelete: SetNull)
  floorId     String?
  floorRef    Floor?        @relation(fields: [floorId], references: [id], onDelete: SetNull)

  // Ownership & Residency History
  history     ApartmentHistory[]

  residents     Resident[]
  contracts     Contract[]
  invoices      Invoice[]
  feedbacks     Feedback[]
  notifications NotificationApartment[]
  vehicles      Vehicle[]
  residenceRequests ResidenceRequest[]
  facilityBookings  FacilityBooking[]
  visitorPasses     VisitorPass[]
  parcels           ParcelDelivery[]
  pollVotes         PollVote[]
  parkingAssignments ParkingAssignment[]
  parkingRequests    ParkingRegistrationRequest[]

  @@index([building])
  @@index([status])
  @@index([buildingId])
  @@index([blockId])
  @@index([floorId])
  @@map("apartments")
}

model ApartmentHistory {
  id            String                @id @default(cuid())
  apartmentId   String
  apartment     Apartment             @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  event         ApartmentHistoryEvent
  title         String
  description   String?
  fromStatus    ApartmentStatus?
  toStatus      ApartmentStatus?
  residentId    String?
  residentName  String?
  performedBy   String?               // e.g. "Admin", "Manager", or user name
  metadata      Json?
  createdAt     DateTime              @default(now())

  @@index([apartmentId, createdAt])
  @@map("apartment_histories")
}

// 3. Resident Profile
model Resident {
  id                  String               @id @default(cuid())
  userId              String?              @unique
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  apartmentId         String?
  apartment           Apartment?           @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  fullName            String
  identityCard        String               @unique // CCCD / Passport
  phone               String
  email               String?
  dateOfBirth         DateTime?
  gender              String?
  relationshipToOwner ResidentRelationship @default(OWNER)
  status              ResidentStatus       @default(RESIDING)
  avatarUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  facilityBookings    FacilityBooking[]
  visitorPasses       VisitorPass[]
  parcels             ParcelDelivery[]
  pollVotes           PollVote[]

  contracts Contract[]
  feedbacks Feedback[]
  vehicles  Vehicle[]
  parkingAssignments ParkingAssignment[]
  parkingRequests    ParkingRegistrationRequest[]

  @@index([apartmentId])
  @@index([status])
  @@index([phone])
  @@map("residents")
}

// 4. Contract
model Contract {
  id           String         @id @default(cuid())
  contractCode String         @unique
  apartmentId  String
  apartment    Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residentId   String
  resident     Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type         ContractType   @default(RENT)
  startDate    DateTime
  endDate      DateTime
  monthlyRent  Float?
  deposit      Float?
  fileUrl      String?
  status       ContractStatus @default(ACTIVE)
  note         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([apartmentId])
  @@index([residentId])
  @@index([status])
  @@index([endDate])
  @@map("contracts")
}

// 5. Fee Category (Danh mục phí)
model FeeCategory {
  id          String   @id @default(cuid())
  code        String   @unique // MGMT, PARKING_MOTO, PARKING_CAR, WATER, ELECTRIC...
  name        String // Phí quản lý, Phí xe máy...
  unit        FeeUnit  @default(PER_MONTH)
  unitPrice   Float
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@map("fee_categories")
}

// 6. Fee Invoice & Items
model Invoice {
  id            String         @id @default(cuid())
  code          String         @unique // e.g. INV-202608-A1001
  apartmentId   String
  apartment     Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  billingMonth  String // "YYYY-MM" e.g. "2026-08"
  dueDate       DateTime
  totalAmount   Float          @default(0)
  status        InvoiceStatus  @default(UNPAID)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  transactionId String?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items InvoiceItem[]

  @@index([apartmentId])
  @@index([status])
  @@index([billingMonth])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id            String       @id @default(cuid())
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategoryId String?
  feeCategory   FeeCategory? @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  title         String
  quantity      Float        @default(1)
  unitPrice     Float
  amount        Float
  note          String?
  createdAt     DateTime     @default(now())

  @@map("invoice_items")
}

// 7. Feedback & Incident Tickets
model Feedback {
  id              String         @id @default(cuid())
  code            String         @unique // e.g. FB-2026-0001
  residentId      String
  resident        Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  apartmentId     String
  apartment       Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  category        TicketCategory @default(OTHER)
  title           String
  content         String
  images          String[]       @default([])
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(NEW)
  responseContent String?

  // SLA & Workflow fields
  assignedStaffId String?
  assignedStaff   User?          @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  slaDueAt        DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  rejectedAt      DateTime?
  rejectReason    String?
  internalNote    String?

  // Reactive linkage to Building Asset
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)

  rating          Int? // 1 to 5 stars
  ratingComment   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  statusHistory   TicketStatusHistory[]
  comments        TicketComment[]

  @@index([apartmentId])
  @@index([residentId])
  @@index([assetId])
  @@index([status])
  @@index([priority])
  @@index([slaDueAt])
  @@map("feedbacks")
}

model TicketStatusHistory {
  id          String       @id @default(cuid())
  feedbackId  String
  feedback    Feedback     @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id], onDelete: Cascade)
  changedAt   DateTime     @default(now())
  note        String?

  @@map("ticket_status_histories")
}

model TicketComment {
  id          String   @id @default(cuid())
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("ticket_comments")
}

// 8. Notifications
model Notification {
  id                String                   @id @default(cuid())
  title             String
  content           String
  isGlobal          Boolean                  @default(true)
  targetRole        Role?
  category          NotificationCategory     @default(GENERAL)
  priority          NotificationPriority     @default(NORMAL)
  targetScope       NotificationTargetScope  @default(ALL)
  publishAt         DateTime?
  expiresAt         DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  senderId          String
  sender            User                     @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt         DateTime                 @default(now())

  apartments        NotificationApartment[]
  reads             NotificationRead[]

  @@index([targetRole])
  @@index([createdAt])
  @@index([category])
  @@index([priority])
  @@index([publishAt])
  @@map("notifications")
}

model NotificationApartment {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  apartmentId    String
  apartment      Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@id([notificationId, apartmentId])
  @@index([apartmentId])
  @@map("notification_apartments")
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

// 9. Audit Logs
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String   // e.g. GENERATE_INVOICES, PROCESS_PAYMENT, UPDATE_RESIDENT, CANCEL_INVOICE, CHANGE_TICKET_STATUS
  entity     String   // e.g. INVOICE, PAYMENT, RESIDENT, TICKET, CONTRACT, APARTMENT
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// 10. Vehicle & Parking Management
model Vehicle {
  id                      String        @id @default(cuid())
  licensePlate            String        @unique // Biển số xe (e.g. "30A-999.88")
  type                    VehicleType   @default(MOTORBIKE)
  brand                   String        // Hãng xe (e.g. "Honda", "Toyota", "VinFast")
  model                   String?       // Dòng xe (e.g. "SH 150i", "Vios G", "VF8")
  color                   String?       // Màu sắc (e.g. "Trắng", "Đen", "Xám")
  apartmentId             String
  apartment               Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residentId              String?
  resident                Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  status                  VehicleStatus @default(PENDING_APPROVAL)
  registrationDocumentUrl String?       // Link ảnh đăng ký xe / cavet
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  parkingCards ParkingCard[]
  parkingAssignments   ParkingAssignment[]
  parkingRequests      ParkingRegistrationRequest[]
  parkingAccessLogs    ParkingAccessLog[]

  @@index([apartmentId])
  @@index([residentId])
  @@index([status])
  @@index([type])
  @@map("vehicles")
}

model ParkingCard {
  id         String            @id @default(cuid())
  cardCode   String            @unique // Mã thẻ từ / RFID (e.g. "CARD-CAR-001")
  vehicleId  String
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  issuedAt   DateTime?         // Thời điểm phát hành thẻ
  expiresAt  DateTime?         // Thời điểm hết hạn thẻ
  status     ParkingCardStatus @default(PENDING)
  lockedAt   DateTime?         // Thời điểm khóa thẻ
  lockReason String?           // Lý do khóa thẻ (e.g. "Báo mất thẻ", "Nợ phí căn hộ")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@map("parking_cards")
}

// 10.1 Smart Parking Management System
model ParkingArea {
  id            String         @id @default(cuid())
  buildingId    String
  building      Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code          String         // e.g. "B1", "B2", "OUTDOOR"
  name          String         // e.g. "Tầng hầm B1", "Tầng hầm B2", "Bãi ngoài trời"
  floor         Int            @default(-1) // e.g. -1 for B1, -2 for B2, 0 for Ground/Outdoor
  totalCapacity Int            @default(0)
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  zones         ParkingZone[]
  slots         ParkingSlot[]
  requests      ParkingRegistrationRequest[]

  @@unique([buildingId, code])
  @@index([buildingId])
  @@map("parking_areas")
}

model ParkingZone {
  id          String        @id @default(cuid())
  areaId      String
  area        ParkingArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  code        String        // e.g. "ZONE-A", "ZONE-B"
  name        String        // e.g. "Khu A - Ô tô", "Khu B - Xe máy & EV"
  vehicleType VehicleType   @default(CAR)
  colorHex    String?       @default("#0F6B4F")
  totalSlots  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slots       ParkingSlot[]
  requests    ParkingRegistrationRequest[]

  @@unique([areaId, code])
  @@index([areaId])
  @@map("parking_zones")
}

model ParkingSlot {
  id           String            @id @default(cuid())
  code         String            // e.g. "B1-A01", "B1-A02"
  areaId       String
  area         ParkingArea       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         ParkingZone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  type         SlotVehicleType   @default(CAR)
  status       ParkingSlotStatus @default(AVAILABLE)
  floor        Int               @default(-1)
  positionX    Float             @default(0)
  positionY    Float             @default(0)
  width        Float?            @default(1)
  height       Float?            @default(1)
  isReservable Boolean           @default(true)
  isActive     Boolean           @default(true)
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignments          ParkingAssignment[]
  registrationRequests ParkingRegistrationRequest[]
  accessLogs           ParkingAccessLog[]

  @@unique([areaId, code])
  @@index([areaId])
  @@index([zoneId])
  @@index([status])
  @@index([type])
  @@map("parking_slots")
}

model ParkingRegistrationRequest {
  id              String               @id @default(cuid())
  requestCode     String               @unique // e.g. "REQ-PARK-2026-0001"
  residentId      String
  resident        Resident             @relation(fields: [residentId], references: [id], onDelete: Cascade)
  apartmentId     String
  apartment       Apartment            @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  preferredAreaId String?
  preferredArea   ParkingArea?         @relation(fields: [preferredAreaId], references: [id], onDelete: SetNull)
  preferredZoneId String?
  preferredZone   ParkingZone?         @relation(fields: [preferredZoneId], references: [id], onDelete: SetNull)
  slotId          String?
  slot            ParkingSlot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  startDate       DateTime             @default(now())
  endDate         DateTime?
  status          ParkingRequestStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  reviewerId      String?
  reviewer        User?                @relation("ReviewedParkingRequests", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  assignment      ParkingAssignment?

  @@index([residentId])
  @@index([apartmentId])
  @@index([vehicleId])
  @@index([status])
  @@index([slotId])
  @@map("parking_registration_requests")
}

model ParkingAssignment {
  id             String                  @id @default(cuid())
  assignmentCode String                  @unique // e.g. "PASS-2026-0001"
  slotId         String
  slot           ParkingSlot             @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  residentId     String?
  resident       Resident?               @relation(fields: [residentId], references: [id], onDelete: SetNull)
  apartmentId    String
  apartment      Apartment               @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  requestId      String?                 @unique
  request        ParkingRegistrationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  startDate      DateTime                @default(now())
  endDate        DateTime?
  status         ParkingAssignmentStatus @default(ACTIVE)
  monthlyFee     Float?                  @default(0)
  qrToken        String                  @unique
  assignedById   String?
  assignedBy     User?                   @relation("AssignedParkingAssignments", fields: [assignedById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([slotId])
  @@index([vehicleId])
  @@index([residentId])
  @@index([apartmentId])
  @@index([status])
  @@index([qrToken])
  @@map("parking_assignments")
}

model ParkingAccessLog {
  id              String              @id @default(cuid())
  slotId          String?
  slot            ParkingSlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  licensePlate    String
  cardCode        String?
  gateName        String              // e.g. "Cổng VÀO 01 (Hầm B1)", "Cổng RA 02"
  direction       ParkingLogDirection @default(ENTRY)
  status          ParkingLogStatus    @default(SUCCESS)
  operatorId      String?
  operator        User?               @relation("OperatedParkingAccessLogs", fields: [operatorId], references: [id], onDelete: SetNull)
  imageSnapshotUrl String?
  notes           String?
  timestamp       DateTime            @default(now())

  @@index([timestamp])
  @@index([licensePlate])
  @@index([status])
  @@index([vehicleId])
  @@map("parking_access_logs")
}

// 11. Household & Residence Requests
model ResidenceRequest {
  id            String                 @id @default(cuid())
  code          String                 @unique // e.g. "REQ-2026-0001"
  type          ResidenceRequestType
  status        ResidenceRequestStatus @default(PENDING)
  apartmentId   String
  apartment     Apartment              @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  requesterId   String
  requester     User                   @relation("RequestedResidence", fields: [requesterId], references: [id], onDelete: Cascade)
  fullName      String
  identityCard  String
  phone         String
  relationship  ResidentRelationship   @default(FAMILY)
  startDate     DateTime?
  endDate       DateTime?
  note          String?
  attachmentUrl String?
  reviewerId    String?
  reviewer      User?                  @relation("ReviewedResidence", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([apartmentId])
  @@index([status])
  @@index([type])
  @@index([requesterId])
  @@map("residence_requests")
}

// 12. Staff Management
model StaffProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String       @unique // e.g. "NV-TECH-001", "NV-SEC-002", "NV-REC-003"
  position         String       // e.g. "Kỹ thuật viên trưởng", "Tổ phó an ninh", "Lễ tân sảnh"
  department       String?      // e.g. "Ban Kỹ thuật", "Đội An ninh", "Tổ Lễ tân"
  currentShift     StaffShift   @default(MORNING)
  status           StaffStatus  @default(ACTIVE)
  joinedDate       DateTime     @default(now())
  
  // Specific assignments: Gate for Security, Lobby for Receptionist, Specialty for Technician
  assignedZone     String?
  notes            String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
  @@index([employeeCode])
  @@index([currentShift])
  @@index([status])
  @@map("staff_profiles")
}

// 13. Asset & Preventive Maintenance
model Asset {
  id              String         @id @default(cuid())
  code            String         @unique // e.g. "AST-ELEV-001"
  name            String         // e.g. "Thang máy tải khách số 1 - Tòa A"
  category        AssetCategory  @default(OTHER)
  buildingId      String?
  building        Building?      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  location        String         // e.g. "Tòa A - Trục 1", "Tầng hầm B2"
  supplier        String?        // e.g. "Schindler VN"
  installDate     DateTime?
  warrantyExpiry  DateTime?
  status          AssetStatus    @default(OPERATIONAL)
  description     String?
  documents       String[]       @default([])
  images          String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  schedules       MaintenanceSchedule[]
  workOrders      WorkOrder[]
  feedbacks       Feedback[]

  @@index([category])
  @@index([status])
  @@index([buildingId])
  @@map("assets")
}

model MaintenanceSchedule {
  id              String            @id @default(cuid())
  code            String            @unique // e.g. "SCH-2026-001"
  assetId         String
  asset           Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title           String            // e.g. "Kiểm tra định kỳ buồng thang & cáp tải"
  cycle           MaintenanceCycle  @default(MONTHLY)
  lastMaintenance DateTime?
  nextMaintenance DateTime
  vendor          String?           // Đơn vị thực hiện
  technicianId    String?
  technician      User?             @relation("TechnicianSchedules", fields: [technicianId], references: [id], onDelete: SetNull)
  status          MaintenanceStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workOrders      WorkOrder[]

  @@index([assetId])
  @@index([technicianId])
  @@index([status])
  @@index([nextMaintenance])
  @@map("maintenance_schedules")
}

model WorkOrder {
  id            String               @id @default(cuid())
  code          String               @unique // e.g. "WO-2026-001"
  scheduleId    String?
  schedule      MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  assetId       String
  asset         Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technicianId  String?
  technician    User?                @relation("TechnicianWorkOrders", fields: [technicianId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  findings      String?              // Kết quả kiểm tra
  cost          Float?               @default(0)
  completedAt   DateTime?
  status        MaintenanceStatus    @default(IN_PROGRESS)
  images        String[]             @default([])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([assetId])
  @@index([technicianId])
  @@index([status])
  @@map("work_orders")
}

// ==========================================
// 8. Facility & Booking Management
// ==========================================

model Facility {
  id          String         @id @default(cuid())
  name        String         // e.g. "Hồ bơi vô cực 4 mùa"
  type        FacilityType   // e.g. SWIMMING_POOL, GYM, BBQ_AREA, COMMUNITY_ROOM, SPORTS_COURT, MEETING_ROOM, OTHER
  description String?
  location    String         // e.g. "Tầng 5 - Tháp Sky Oasis"
  buildingId  String?
  building    Building?      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  openTime    String         @default("06:00") // HH:mm
  closeTime   String         @default("22:00") // HH:mm
  slotDuration Int           @default(60) // in minutes
  maxUsers    Int            @default(1)  // maximum allowed capacity/users per slot (1 for exclusive booking)
  fee         Float          @default(0)  // Fee per slot in VND (0 for free)
  status      FacilityStatus @default(ACTIVE)
  images      String[]       @default([])
  rules       String?        // Nội quy sử dụng
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  bookings    FacilityBooking[]

  @@index([type])
  @@index([status])
  @@index([buildingId])
  @@map("facilities")
}

model FacilityBooking {
  id              String        @id @default(cuid())
  bookingCode     String        @unique // e.g. "BK-2026-001"
  facilityId      String
  facility        Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  residentId      String?
  resident        Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  apartmentId     String?
  apartment       Apartment?    @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  bookingDate     DateTime      // The day of booking (start of day or normalized)
  startTime       String        // e.g. "17:00"
  endTime         String        // e.g. "18:00"
  startTimeDate   DateTime      // exact start timestamp for overlapping queries
  endTimeDate     DateTime      // exact end timestamp for overlapping queries
  numberOfUsers   Int           @default(1)
  totalFee        Float         @default(0)
  status          BookingStatus @default(CONFIRMED)
  notes           String?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([facilityId, bookingDate])
  @@index([userId])
  @@index([apartmentId])
  @@index([status])
  @@index([startTimeDate, endTimeDate])
  @@map("facility_bookings")
}

// ==========================================
// 9. Visitor Management & QR Access
// ==========================================

model VisitorPass {
  id              String        @id @default(cuid())
  passCode        String        @unique // e.g. "VP-2026-0001"
  qrCode          String        @unique // Unique secure token
  visitorName     String
  visitorPhone    String
  visitDate       DateTime      // Day of visit
  expectedTime    String        // e.g. "19:00 - 22:00"
  licensePlate    String?       // e.g. "29B1-888.99"
  note            String?
  status          VisitorStatus @default(PENDING)

  apartmentId     String
  apartment       Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  residentId      String?
  resident        Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)

  createdById     String
  createdBy       User          @relation("CreatedVisitorPasses", fields: [createdById], references: [id], onDelete: Cascade)

  checkInAt       DateTime?
  checkedInById   String?
  checkedInBy     User?         @relation("CheckedInVisitorPasses", fields: [checkedInById], references: [id], onDelete: SetNull)

  checkOutAt      DateTime?
  checkedOutById  String?
  checkedOutBy    User?         @relation("CheckedOutVisitorPasses", fields: [checkedOutById], references: [id], onDelete: SetNull)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([apartmentId])
  @@index([status])
  @@index([visitDate])
  @@index([createdById])
  @@map("visitor_passes")
}


// ============================================================================
// PARCEL MANAGEMENT (BƯU KIỆN & GIAO NHẬN)
// ============================================================================

enum ParcelStatus {
  RECEIVED
  NOTIFIED
  COLLECTED
  RETURNED
  EXPIRED
  CANCELLED
}

model ParcelDelivery {
  id              String        @id @default(cuid())
  apartmentId     String
  apartment       Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  recipientId     String?
  recipient       Resident?     @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientName   String
  recipientPhone  String?
  carrier         String
  trackingNumber  String?
  pickupCode      String
  photoUrl        String?
  location        String?
  note            String?
  status          ParcelStatus  @default(RECEIVED)
  receivedAt      DateTime      @default(now())
  notifiedAt      DateTime?
  collectedAt     DateTime?
  receivedById    String?
  receivedBy      User?         @relation("ReceivedParcels", fields: [receivedById], references: [id], onDelete: SetNull)
  collectedById   String?
  collectedBy     User?         @relation("HandedOverParcels", fields: [collectedById], references: [id], onDelete: SetNull)
  collectedByName String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([apartmentId])
  @@index([recipientId])
  @@index([status])
  @@index([pickupCode])
  @@index([receivedAt])
  @@map("parcel_deliveries")
}


// ============================================================================
// COMMUNICATION & POLL / VOTING ENUMS & MODELS
// ============================================================================

enum NotificationCategory {
  GENERAL
  EMERGENCY
  MAINTENANCE
  BILLING
  EVENT
  PARCEL
  VISITOR
  POLL
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  EMERGENCY
}

enum NotificationTargetScope {
  ALL
  BUILDING
  BLOCK
  FLOOR
  APARTMENT
}

enum PollStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum PollTargetScope {
  ALL_APARTMENTS
  BUILDING
  BLOCK
  FLOOR
  SELECTED_APARTMENTS
}

model Poll {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      PollStatus      @default(DRAFT)
  targetScope PollTargetScope @default(ALL_APARTMENTS)
  targetValue String?
  startAt     DateTime        @default(now())
  endAt       DateTime
  createdById String
  createdBy   User            @relation("CreatedPolls", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  options     PollOption[]
  votes       PollVote[]

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([createdById])
  @@map("polls")
}

model PollOption {
  id           String     @id @default(cuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label        String
  displayOrder Int        @default(0)
  votes        PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id              String      @id @default(cuid())
  pollId          String
  poll            Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId        String
  option          PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  apartmentId     String
  apartment       Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  voterResidentId String?
  voterResident   Resident?   @relation(fields: [voterResidentId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())

  // RÀNG BUỘC CỐT LÕI: MỖI CĂN HỘ CHỈ ĐƯỢC TÍNH 1 PHIẾU DUY NHẤT
  @@unique([pollId, apartmentId])
  @@index([pollId])
  @@index([apartmentId])
  @@index([optionId])
  @@map("poll_votes")
}



// =========================================================================
// SMART OPERATIONS & IOT SENSOR SIMULATION
// =========================================================================

enum IoTSensorType {
  TEMPERATURE
  SMOKE
  WATER_LEVEL
  WATER_LEAKAGE
  PUMP_PRESSURE
  POWER
  ELEVATOR
}

enum IoTSensorStatus {
  NORMAL
  WARNING
  CRITICAL
  OFFLINE
}

model IoTSensor {
  id           String          @id @default(cuid())
  code         String          @unique // e.g. SENSOR-LEAK-F12, SENSOR-SMOKE-F12, ELEV-A01
  name         String          // e.g. Cảm biến rò rỉ nước tầng 12, Cảm biến khói PCCC
  type         IoTSensorType
  location     String          // e.g. Tầng 12 - Tháp A, Tầng hầm B2
  unit         String          // °C, ppm, %, bar, kWh, ONLINE/OFFLINE
  currentValue String          // Giá trị hiện tại
  thresholdMin Float?
  thresholdMax Float?
  status       IoTSensorStatus @default(NORMAL)
  lastUpdated  DateTime        @default(now())
  isEnabled    Boolean         @default(true)
  metadata     Json?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  alerts       SmartAlertRecord[]

  @@index([type])
  @@index([status])
  @@map("iot_sensors")
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum SmartAlertSource {
  IOT
  SLA
  INVOICE
  CONTRACT
  MAINTENANCE
}

enum SmartAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model SmartAlertRecord {
  id                String             @id @default(cuid())
  title             String
  description       String
  type              String             // e.g. WATER_LEAKAGE, SMOKE_DETECTED, SLA_BREACHED
  severity          AlertSeverity      // INFO, WARNING, HIGH, CRITICAL
  source            SmartAlertSource   // IOT, SLA, INVOICE, CONTRACT, MAINTENANCE
  status            SmartAlertStatus   @default(OPEN)
  location          String?
  relatedEntityType String?            // TICKET, INVOICE, CONTRACT, SENSOR
  relatedEntityId   String?
  actionUrl         String?
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  resolvedAt        DateTime?
  resolvedById      String?
  sensorId          String?
  sensor            IoTSensor?         @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([severity])
  @@index([source])
  @@map("smart_alerts")
}
